{
  "expo": {
    "name": "Music Comp",
    "slug": "music-leeg",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musicleague",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "puchalski.12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicleeg.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Music Leeg to access your photos to set your profile and league images.",
        "NSCameraUsageDescription": "Allow Music Leeg to use your camera to take profile and league photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#212F36"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.musicleeg.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#212F36"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d5542b6-129f-44be-9a86-516abc2effb7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6ac7b7bd-50f5-4149-a750-f374aaea23c2"
    }
  }
}
